# Private planning, design, backlog and session records are transferred manually.
# (Stable public policy docs — tests_rules.md and architecture/ — are committed;
# see ADR-10 for the current scope.)
/docs/*
!docs/tests_rules.md
!docs/architecture/

# Local runtime configuration; commit only sanitized examples.
.env
.env.*
!.env.example
*.local.yaml
*.local.yml

# Generated environments, caches and outputs.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
/videos/
/results/
/models/
/weights/
*.pt
*.engine
*.onnx
*.so

# Benchmark detection outputs (large, reproducible).
benchmarks/**/*.jsonl

# Local scratch and benchmark footage; keep media out of Git.
/_s*.mp4
/benchmarks/**/*.mp4
