# AVA observability platform runtime configuration (B-022).
#
# Copy to ops/.env and fill in real values. ops/.env is git-ignored; never
# commit real credentials.

# Port the host-run `ava live` process exposes its /metrics endpoint on
# (live.telemetry.prometheus_port in the run config). Prometheus scrapes it
# via host.docker.internal.
AVA_METRICS_PORT=9464

# Grafana admin account (development only; not a production security template).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
