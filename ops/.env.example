# AVA observability platform runtime configuration (B-022).
#
# Copy to ops/.env and fill in real values. ops/.env is git-ignored; never
# commit real credentials.

# Grafana admin account (development only; not a production security template).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# PostgreSQL credentials (B-023). Development only.
POSTGRES_PASSWORD=dev-change-me

# Keycloak identity provider (F-1-S3). Development only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Required notification endpoint reachable from the Compose network.
# Set a real HTTP(S) receiver URL; localhost would refer to each container.
AVA_ALERT_WEBHOOK_URL=

# Optional: use the same absolute directory for Compose and host-run backups.
# Export this setting when invoking ops/backup.sh or make db-backup.
# AVA_BACKUP_DIR=/absolute/path/to/ops-backups
