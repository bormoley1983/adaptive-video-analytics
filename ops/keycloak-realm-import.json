{
  "realm": "ava",
  "enabled": true,
  "displayName": "AVA Analytics",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {"name": "operator", "description": "AVA operator role"},
      {"name": "tenant-admin", "description": "AVA tenant admin role"}
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "ava-api-audience-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "ava-api-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ava-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ava-api",
      "name": "AVA API Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "ava-api-secret-dev-only",
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["basic", "ava-api-audience-scope"],
      "protocolMappers": [
        {
          "name": "tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "dev-tenant",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "roles",
            "claim.value": "[\"operator\",\"admin\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ava-web",
      "name": "AVA Web UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["basic", "ava-api-audience-scope"],
      "protocolMappers": [
        {
          "name": "tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant",
            "claim.value": "dev-tenant",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "roles",
            "claim.value": "[\"operator\",\"admin\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "test-operator",
      "enabled": true,
      "email": "operator@ava.local",
      "firstName": "Test",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "dev-test-password-123",
          "temporary": false
        }
      ],
      "realmRoles": ["operator", "tenant-admin"]
    }
  ]
}
